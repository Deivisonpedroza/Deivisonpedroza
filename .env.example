# Credenciais do app criado em developer.bling.com.br (NUNCA commitar o .env real)
BLING_CLIENT_ID=
BLING_CLIENT_SECRET=

# ID da loja Shopee dentro do Bling (GET /canais-venda ou veja em Vendas > Pedidos)
BLING_LOJA_ID_SHOPEE=
# IDs das situacoes que significam "pronto para separar/enviar", separados por virgula
BLING_SITUACOES_IDS=

# Emitir NF-e automaticamente para pedidos sem nota? Comece com false.
AUTO_EMIT_NFE=false

# Impressoras CUPS (lpstat -p). Deixe LABEL_PRINTER vazio para nao imprimir etiquetas.
LABEL_PRINTER=
A4_PRINTER=
# ZPL (termica Zebra/Elgin/Argox em ZPL) ou PDF
LABEL_FORMAT=ZPL

DATA_DIR=./data
DRY_RUN=false
