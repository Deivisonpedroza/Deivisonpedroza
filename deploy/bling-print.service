[Unit]
Description=Robo Bling -> NF-e -> impressao termica
After=network-online.target cups.service
Wants=network-online.target

[Service]
WorkingDirectory=/opt/bling-print
EnvironmentFile=/opt/bling-print/.env
ExecStart=/opt/bling-print/.venv/bin/python -m bling_print watch
Restart=always
RestartSec=15

[Install]
WantedBy=multi-user.target
